; Godot project file for Dungeon Dudes.
; Shared by every lane. Change it only in a small PR that contains nothing else,
; and say why in docs/changes/. The client lane will add the main scene.

config_version=5

[application]

config/name="Dungeon Dudes"
config/description="Co-op roguelike deckbuilder. Rules core in res://core, content in res://data."
run/main_scene="res://client/run/run_screen.tscn"
config/features=PackedStringArray("4.7")

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0

[rendering]

; Task 051: lets the macOS export build its universal (x86_64 + arm64) app, which Godot refuses
; unless ETC2/ASTC texture import is on. Every texture in the project imports lossless
; (compress/mode=0), so this changes no imported texture. Shared contract: change only in its own PR.
textures/vram_compression/import_etc2_astc=true
